{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-confirm",
    "shell:allow-open",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "fs:allow-read",
      "scope": [
        "../docs/**",
        "$RESOURCE/docs/**"
      ]
    },
    {
      "identifier": "core:event:allow-listen",
      "scope": {
        "event": [
          "ask_pairing_approval",
          "remote_command::toggle_home",
          "test-event"
        ]
      }
    },
    {
      "identifier": "core:event:allow-emit",
      "scope": {
        "event": [
          "ask_pairing_approval",
          "remote_command::toggle_home",
          "test-event"
        ]
      }
    }
  ],
  "ipc": {
    "allow": [
      "reply_to_pairing_request",
      "get_network_interfaces",
      "generate_qrcode_base64",
      "get_remote_control_status"
    ]
  }
}