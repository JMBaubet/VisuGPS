{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VisuGPS",
  "version": "1.0.0",
  "identifier": "com.visugps.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "visugps",
        "minWidth": 1024,
        "maximized": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost https://api.iconify.design data: blob:; connect-src 'self' http://ipc.localhost https://api.mapbox.com https://events.mapbox.com https://api.open-meteo.com http://connectivitycheck.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "../docs/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "plugins": {
    "process": {
      "allowlist": [
        "relaunch"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public",
      "../docs"
    ]
  }
}